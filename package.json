{
  "name": "bd-preorder-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx e2e/prepare-db.ts && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed-cli.ts",
    "db:setup": "tsx db/setup.ts",
    "db:server": "tsx db/dev-server.ts",
    "test:e2e:only": "playwright test",
    "test:e2e:prod": "tsx e2e/prepare-db.ts && next build && cross-env E2E_PRODUCTION=1 playwright test",
    "db:migrate:deploy": "tsx db/migrate.ts",
    "db:seed:scale": "tsx db/seed-scale.ts",
    "pkb:backfill": "tsx db/pkb-backfill.ts",
    "perf:bench": "tsx scripts/perf/bench.ts",
    "perf:http": "node scripts/perf/http-load.mjs",
    "perf:vitals": "node scripts/perf/vitals.mjs",
    "perf:admin": "tsx scripts/perf/admin-load.ts",
    "perf:ux": "node scripts/perf/ux-sweep.mjs",
    "perf:budget": "node scripts/perf/budget.mjs",
    "jobs:dev": "node scripts/jobs/dev-scheduler.mjs",
    "worker": "tsx scripts/jobs/worker.ts",
    "staging:check": "tsx scripts/staging/check.ts",
    "vercel-build": "tsx db/migrate.ts && next build",
    "perf:search-rebuild": "tsx scripts/perf/search-rebuild-bench.ts",
    "perf:search-console": "tsx scripts/perf/search-console-bench.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@node-rs/argon2": "^2.2.0",
    "@sentry/nextjs": "10.75.0",
    "@types/sanitize-html": "^2.16.1",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.2.0",
    "htmlparser2": "^10.1.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.13",
    "playwright-core": "1.63.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": false,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": false
  },
  "engines": {
    "node": "22.x"
  }
}
