# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string (local dev or Neon branch).
# `npm run db:server` starts a real PostgreSQL server locally using binaries
# shipped by embedded-postgres, so no system install is needed.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/preorder


# 32+ character random string used to sign session cookies
SESSION_SECRET=

# Provider selection. 'mock' runs the full app with no external credentials.
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
