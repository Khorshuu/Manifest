# Copy to .env.local and fill in. Never commit .env.local.
#
# Names and placeholders only: no real value belongs in this file. A hosted
# environment (docs/STAGING.md) sets the same names in its host's settings —
# the web application's on Vercel, the worker's on the worker's machine.
# A blank value means "not set".
#
# Sections: APP / DATABASE · BACKGROUND JOBS · MEDIA · NOTIFICATIONS ·
# RESEARCH · SEARXNG · OLLAMA · SEO PULSE · SEARCH CONSOLE · PAYMENT ·
# SHIPPING · SIGN-IN · OBSERVABILITY

# =========================================================== APP / DATABASE

# Postgres connection string.
# Development: `npm run db:server` starts a real PostgreSQL server locally
# using binaries shipped by embedded-postgres, so no system install is needed.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/preorder
# Hosted (Neon or any managed Postgres with a pooler):
#   web application  DATABASE_URL = the POOLED address ("-pooler" host)
#                    DATABASE_URL_UNPOOLED = the DIRECT address (migrations)
#   worker           DATABASE_URL = the DIRECT address. The local-AI slot is a
#                    session advisory lock, which a transaction pooler cannot
#                    hold; the worker refuses a pooled address when local AI is on.
# Every environment has its own database: staging never points at the
# development, end-to-end, scale-test or production database.
# DATABASE_URL_UNPOOLED=
# Connections per instance: unset means 3 on Vercel, 10 elsewhere.
# DATABASE_POOL_MAX=
# Named prepared statements: auto (off behind a "-pooler" address) | on | off.
# Behind a pooler whose host name does not contain "-pooler", set off.
DATABASE_PREPARE=auto
# How DATABASE_URL reaches the server: direct | session | transaction
# (docs/DECISIONS.md D-134). Only Neon's "-pooler" host says so by itself; for
# any other provider an address is "unknown" until this says what it is.
# transaction (a transaction pooler) turns prepared statements off and is
# refused by the worker's local-AI slot and by migrations. The worker tests
# a real session lock at start either way.
# DATABASE_CONNECTION_MODE=
# The database this environment owns, e.g. manifest_staging. Migrations
# (vercel-build) and the worker stop before writing when current_database()
# is anything else. Unset: not checked.
# EXPECTED_DATABASE_NAME=

# 32+ character random string used to sign session cookies. Different in
# every environment.
SESSION_SECRET=

# The site's public address, without a trailing slash. Used for canonical
# links, the sitemap and sign-in callbacks. Unset, a Vercel deployment uses
# its own address and everything else uses http://localhost:3000.
# SITE_URL=

# Creates the first administrator on a fresh database, once (db/migrate.ts).
# Registration only ever creates customers, so a new shop has no other way in.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Login attempts allowed per 15-minute window. Defaults shown; the per-account
# limit is the meaningful one, and the per-IP ceiling is high because many
# legitimate users share an address behind a NAT.
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
LOGIN_RATE_LIMIT_PER_IP=60
# Second-factor attempts allowed per 15-minute window. Exhausting either ceiling
# destroys the pending sign-in rather than leaving it open to retry.
TWO_FACTOR_RATE_LIMIT_PER_ACCOUNT=10
TWO_FACTOR_RATE_LIMIT_PER_IP=30
# Hourly ceilings on public writes (lib/http/throttle.ts)
CHECKOUT_RATE_LIMIT_PER_IP=20
CHECKOUT_RATE_LIMIT_PER_EMAIL=10
REGISTER_RATE_LIMIT_PER_IP=10
ORDER_LOOKUP_RATE_LIMIT_PER_IP=30
# Public search, per visitor: suggestions per 10 seconds, result clicks per minute.
# SEARCH_SUGGEST_LIMIT=40
# SEARCH_CLICK_LIMIT=30

# ========================================================== BACKGROUND JOBS

# Shared secret for the scheduler and the worker: /api/cron/jobs,
# /api/cron/maintenance, /api/cron/health and /api/cron/revalidate refuse every
# request without it, including a real scheduler's. Long and random; different
# in every environment.
CRON_SECRET=change-me-to-a-long-random-string

# Who runs background jobs (docs/DECISIONS.md D-133):
#   scheduler  whatever calls /api/cron/jobs runs them in the web application
#              (the default; `npm run dev` does this locally)
#   worker     a long-running `npm run worker` process runs them, and
#              /api/cron/jobs declines. Set the same value on the web
#              application and on the worker.
# JOB_RUNNER=scheduler

# The worker only (`npm run worker`):
# WORKER_INTERVAL_SECONDS=15           # seconds between ticks (5-600)
# WORKER_MAX_CONCURRENT_TICKS=3        # ticks at once, so a slow job does not hold up the rest (1-8)
# WORKER_SHUTDOWN_GRACE_SECONDS=25     # how long SIGTERM waits for work in hand
# WORKER_WEB_URL=                      # the web application's address, for cache invalidation; defaults to SITE_URL
# VERCEL_AUTOMATION_BYPASS_SECRET=     # only if the web deployment has Vercel Deployment Protection on
# WORKER_ALIVE_FILE=                   # touched every loop; read by scripts/jobs/worker-alive.mjs (the image sets it)
# WORKER_ALIVE_MAX_AGE_SECONDS=        # the health check's limit; default four ticks, at least 60

# Optional per-environment job intervals (docs/DECISIONS.md D-059), overriding
# the defaults in lib/jobs/registry.ts: kind=minutes or kind=off, comma-separated.
# The scheduler must call /api/cron/jobs at least as often as the shortest one.
# JOB_SCHEDULE="media.sweep_unreferenced=off,notifications.deliver=5"

# ==================================================================== MEDIA

# Where product photography is stored: 'local' writes to .uploads/ on disk,
# 'blob' writes to Vercel Blob. Left unset, a deployment that has a Blob store
# uses it and everything else writes to disk. A serverless host has no
# persistent disk, so 'local' cannot work there.
# Each environment has its own Blob store: staging never shares one with
# production, development or the end-to-end suite. The worker needs the same
# two values as the web application (it runs the unreferenced-media sweep).
# MEDIA_PROVIDER=blob
# BLOB_READ_WRITE_TOKEN=        # set automatically by Vercel when a store is linked
# The only folder this environment writes, reads, sweeps or deletes in
# (D-134). Default `products`. If a store is ever shared with production,
# give staging its own, e.g. staging/products.
# MEDIA_BLOB_PREFIX=products

# ============================================================ NOTIFICATIONS

# 'mock' delivers nowhere and says so. 'smtp' sends real email through
# whichever transactional email service the settings below name
# (docs/DECISIONS.md D-132). Set the same values on the web application and on
# the worker. Automated tests always use the mock.
NOTIFICATION_PROVIDER=mock

# Required when NOTIFICATION_PROVIDER=smtp. The service's SMTP endpoint, as
# its own documentation gives it.
# SMTP_HOST=
# SMTP_PORT=587                        # 587 requires STARTTLS; 465 is TLS from the start
# SMTP_SECURE=                         # true for TLS from the start; unset: true on port 465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TIMEOUT_MS=20000
# EMAIL_FROM=                          # the sender customers see, on a domain verified with the service
# EMAIL_FROM_NAME=
# EMAIL_REPLY_TO=
# Staging: only these recipients are ever written to — whole addresses, or
# @domain for everyone at one — so a test order cannot email a real customer.
# Leave unset in production.
# NOTIFICATION_RECIPIENT_ALLOWLIST=

# ================================================================= RESEARCH
#
# Automatic discovery of candidate source pages for the knowledge base. Optional
# in the strongest sense: with none set, product preparation still finds sources
# in the Brand Source Registry, in the addresses staff attach to a product and
# in the documents they provide, and reports the automatic part as
# NOT_CONFIGURED rather than pretending to have searched (A-6).
#
# A provider only ever returns addresses. Every page it names is still fetched
# through the SSRF-guarded fetcher, checked against robots.txt, matched against
# the product's own identifiers and proposed as a claim a person accepts. No
# search result becomes a product fact.
#
#   none   the default
#   local  free: official-domain sitemaps, plus SearXNG when SEARXNG_BASE_URL is set
#   brave  paid API; create a key at https://api-dashboard.search.brave.com/
# PRODUCT_RESEARCH_PROVIDER=none       # none | brave | local
# BRAVE_SEARCH_API_KEY=                # required when PRODUCT_RESEARCH_PROVIDER=brave

# Intelligent document extraction (D-123). Optional, off by default. A page
# Manifest already retrieved, whose facts are in sentences rather than tables,
# is also read by a model, which must quote the page for everything it
# reports. Every value is checked word for word against the page's own text;
# the stored evidence is the page's excerpt, never the model's wording; and
# each value is still a claim a person accepts.
#   none       the default
#   ollama     the shop's own model, no key (OLLAMA section below)
#   anthropic  paid hosted AI; uses ANTHROPIC_API_KEY
# PRODUCT_EXTRACTION_PROVIDER=none     # none | anthropic | ollama
# PRODUCT_EXTRACTION_MODEL=claude-opus-5

# Renders a page that shows nothing without JavaScript. Every request the
# browser makes still goes through the SSRF-guarded fetcher. Needed only where
# research jobs run: this computer in development, the worker when hosted.
# LOCAL_BROWSER_RENDERER=none          # none | playwright (npx playwright install chromium)

# ================================================================== SEARXNG
#
# Web search for PRODUCT_RESEARCH_PROVIDER=local, through a SearXNG instance
# you run (docs/LOCAL_AI_SETUP.md, docs/STAGING.md). JSON output must be
# enabled in its settings.yml.
#
# Only loopback addresses are used unless SEARXNG_ALLOW_REMOTE is true. A
# remote address must then be on a private network (a private IP, a service
# name such as http://searxng:8080, or a name under .internal) or use https.
# Never expose SearXNG to the internet without authentication in front of it.
# SEARXNG_BASE_URL=http://127.0.0.1:8080
# SEARXNG_ALLOW_REMOTE=false
# SEARXNG_AUTH_TOKEN=                  # bearer token, only when SearXNG sits behind a gateway that asks for one
# SEARXNG_SECRET=                      # deploy/worker-stack.compose.yml only: SearXNG's own secret_key, any long random string

# =================================================================== OLLAMA
#
# The model behind PRODUCT_EXTRACTION_PROVIDER=ollama and
# SEO_PULSE_AI_PROVIDER=ollama (D-124). No per-product charge and no cloud
# fallback: when it is not answering, jobs wait, retry or fail with that reason.
#
# Only loopback addresses are used unless OLLAMA_ALLOW_REMOTE is true —
# changing OLLAMA_BASE_URL alone never sends a product document anywhere. A
# remote address must then be on a private network or use https. Ollama has no
# authentication of its own: never expose its port to the internet; put it on
# a private network, or behind a gateway that requires OLLAMA_AUTH_TOKEN.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_ALLOW_REMOTE=false
# OLLAMA_AUTH_TOKEN=                   # bearer token, only when Ollama sits behind a gateway that asks for one
# OLLAMA_MODEL=                        # a model installed in Ollama, e.g. qwen2.5:7b; no default
# OLLAMA_EXTRACTION_MODEL=             # optional, overrides OLLAMA_MODEL for reading pages
# OLLAMA_SEO_MODEL=                    # optional, overrides OLLAMA_MODEL for SeoPulse
# OLLAMA_TIMEOUT_MS=240000
# OLLAMA_NUM_CTX=16384
# LOCAL_AI_CONCURRENCY=1              # model calls at once (1-4). Keep 1 until the GPU has been benchmarked.
# LOCAL_AI_QUEUE_WAIT_MS=              # wait for a turn before OLLAMA_QUEUE_WAIT_TIMEOUT; default one call's worst case
# LOCAL_AI_SERVICE_WAIT_MINUTES=30     # worker only: how long a local-AI job stays queued while Ollama is down
#                                      # before it runs anyway with the rules generator (0: never wait)
# The GPU machine (deploy/gpu-stack.compose.yml, its own env file):
# OLLAMA_BIND_ADDRESS=                 # this machine's private-network address; never 0.0.0.0
# OLLAMA_GATEWAY_DOMAIN=               # only with the https gateway (--profile gateway)

# ================================================================ SEO PULSE
#
# The content generator (docs/DECISIONS.md D-038, D-124, D-125):
#   rules      no AI, no charge (the default)
#   ollama     the shop's own model (OLLAMA section above)
#   anthropic  optional paid hosted AI (needs ANTHROPIC_API_KEY)
# External keyword data (DataForSEO) is optional and paid, and is not called
# while SEO_PULSE_AI_PROVIDER=ollama.
# SEO_PULSE_AI_PROVIDER=rules          # rules | ollama | anthropic
# SEO_PULSE_AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=                   # shared with PRODUCT_EXTRACTION_PROVIDER=anthropic
# SEO_PULSE_DATA_PROVIDER=dataforseo   # none | dataforseo
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# SEO_PULSE_LOCATION_CODE=2050         # Google Ads location; 2050 = Bangladesh
# SEO_PULSE_MAX_RUNS_PER_HOUR=30       # per staff member

# =========================================================== SEARCH CONSOLE
#
# Google Search Console (docs/KNOWLEDGE_PLATFORM.md, D-096). Entirely
# optional: left unset, the shop reports "Search Console not connected" and
# everything else works exactly as before. Nothing is estimated in its absence.
#
# Set up: create a service account in Google Cloud, enable the Search Console
# API for it, then add its email as a user of the property in Search Console.
# Paste the whole downloaded key JSON as one variable. Credentials stay on the
# server and are never sent to a browser.
# SEARCH_CONSOLE_PROVIDER=google       # none | google
# SEARCH_CONSOLE_SITE_URL=             # exactly as Search Console spells it, e.g. sc-domain:example.com
# GOOGLE_SEARCH_CONSOLE_CREDENTIALS=   # the service-account key JSON, on one line
# GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=  # or these two instead of the JSON above
# GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# SEARCH_CONSOLE_BACKFILL_DAYS=90      # how far back a first sync reaches
# SEARCH_CONSOLE_REFRESH_DAYS=5        # recent days re-read each sync; Google revises them
# SEARCH_CONSOLE_LAG_DAYS=2            # the newest day worth asking for
# SEARCH_CONSOLE_ROW_LIMIT=5000        # rows per request; Google's ceiling is 25000
# SEARCH_CONSOLE_MAX_REQUESTS=60       # ceiling on one sync
# SEARCH_CONSOLE_RETENTION_DAYS=480    # how long measurements are kept

# ================================================================== PAYMENT

# 'mock' runs the full checkout with no gateway and takes no money. No real
# gateway is implemented; staging stays on the mock.
PAYMENT_PROVIDER=mock
# Secret the payment provider signs webhooks with (32+ characters). Without it
# /api/webhooks/payments/<provider> refuses every request.
PAYMENT_WEBHOOK_SECRET=

# ================================================================= SHIPPING

# 'mock' books nothing with any courier. No real courier is implemented;
# staging stays on the mock.
SHIPPING_PROVIDER=mock

# ================================================================== SIGN-IN

# Signing in with Google (docs/DECISIONS.md D-041). Optional: left unset, the
# button is not shown and the two /api/auth/google routes answer 404.
# Create an OAuth client (type: Web application) in the Google Cloud console
# and register the callback below as an authorised redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=          # defaults to ${SITE_URL}/api/auth/google/callback

# ============================================================ OBSERVABILITY

# Error tracking (docs/OBSERVABILITY.md). Off when SENTRY_DSN is empty. Set on
# the worker too, so a dead job there is reported like one in the web application.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production   # defaults to VERCEL_ENV, then NODE_ENV
# SENTRY_TRACES_SAMPLE_RATE=0     # performance tracing; off unless above 0
