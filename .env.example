# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string (local dev or Neon branch).
# `npm run db:server` starts a real PostgreSQL server locally using binaries
# shipped by embedded-postgres, so no system install is needed.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/preorder
# Production (Neon): DATABASE_URL is the pooled "-pooler" address the app uses;
# DATABASE_URL_UNPOOLED is the direct address migrations use (db/migrate.ts).
# DATABASE_URL_UNPOOLED=
# Connections per instance: unset means 3 on Vercel, 10 elsewhere.
# DATABASE_POOL_MAX=
# Named prepared statements: auto (off behind a pooler) | on | off
DATABASE_PREPARE=auto


# 32+ character random string used to sign session cookies
SESSION_SECRET=

# Provider selection. 'mock' runs the full app with no external credentials.
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
NOTIFICATION_PROVIDER=mock

# Secret the payment provider signs webhooks with (32+ characters). Without it
# /api/webhooks/payments/<provider> refuses every request.
PAYMENT_WEBHOOK_SECRET=

# Login attempts allowed per 15-minute window. Defaults shown; the per-account
# limit is the meaningful one, and the per-IP ceiling is high because many
# legitimate users share an address behind a NAT.
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
LOGIN_RATE_LIMIT_PER_IP=60
# Second-factor attempts allowed per 15-minute window. Exhausting either ceiling
# destroys the pending sign-in rather than leaving it open to retry.
TWO_FACTOR_RATE_LIMIT_PER_ACCOUNT=10
TWO_FACTOR_RATE_LIMIT_PER_IP=30
# Hourly ceilings on public writes (lib/http/throttle.ts)
CHECKOUT_RATE_LIMIT_PER_IP=20
CHECKOUT_RATE_LIMIT_PER_EMAIL=10
REGISTER_RATE_LIMIT_PER_IP=10
ORDER_LOOKUP_RATE_LIMIT_PER_IP=30

# Shared secret for the scheduled sweep at /api/cron/maintenance.
# Without it that endpoint refuses every request, including a real scheduler.
CRON_SECRET=change-me-to-a-long-random-string

# Optional per-environment job intervals (docs/DECISIONS.md D-059), overriding
# the defaults in lib/jobs/registry.ts: kind=minutes or kind=off, comma-separated.
# The scheduler must call /api/cron/jobs at least as often as the shortest one.
# JOB_SCHEDULE="media.sweep_unreferenced=off,notifications.deliver=5"

# SEO Pulse (docs/DECISIONS.md D-038, D-124, D-125). The content generator:
#   rules      local, no AI, no charge (the default)
#   ollama     local AI on this computer, no API charge (setup below)
#   anthropic  optional paid hosted AI (needs ANTHROPIC_API_KEY)
# External keyword data (DataForSEO) is optional and paid, and is not called
# while SEO_PULSE_AI_PROVIDER=ollama.
# SEO_PULSE_AI_PROVIDER=rules          # rules | ollama | anthropic
# SEO_PULSE_AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
# SEO_PULSE_DATA_PROVIDER=dataforseo   # none | dataforseo
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# SEO_PULSE_LOCATION_CODE=2050         # Google Ads location; 2050 = Bangladesh
# SEO_PULSE_MAX_RUNS_PER_HOUR=30       # per staff member

# Where product photography is stored: 'local' writes to .uploads/ on disk,
# 'blob' writes to Vercel Blob. Left unset, a deployment that has a Blob store
# uses it and everything else writes to disk. A serverless host has no
# persistent disk, so 'local' cannot work there.
# MEDIA_PROVIDER=blob
# BLOB_READ_WRITE_TOKEN=        # set automatically by Vercel when a store is linked

# Signing in with Google (docs/DECISIONS.md D-041). Optional: left unset, the
# button is not shown and the two /api/auth/google routes answer 404.
# Create an OAuth client (type: Web application) in the Google Cloud console
# and register the callback below as an authorised redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=          # defaults to ${SITE_URL}/api/auth/google/callback

# Creates the first administrator on a fresh database, once (db/migrate.ts).
# Registration only ever creates customers, so a new shop has no other way in.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Error tracking (docs/OBSERVABILITY.md). Off when SENTRY_DSN is empty.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production   # defaults to VERCEL_ENV, then NODE_ENV
# SENTRY_TRACES_SAMPLE_RATE=0     # performance tracing; off unless above 0

# Google Search Console (docs/KNOWLEDGE_PLATFORM.md, D-096). Entirely
# optional: left unset, the shop reports "Search Console not connected" and
# everything else — SeoPulse, SearchPulse, the storefront, the knowledge base —
# works exactly as before. Nothing is estimated in its absence.
#
# Set up: create a service account in Google Cloud, enable the Search Console
# API for it, then add its email as a user of the property in Search Console.
# Paste the whole downloaded key JSON as one variable. Credentials stay on the
# server and are never sent to a browser.
# SEARCH_CONSOLE_PROVIDER=google       # none | google
# SEARCH_CONSOLE_SITE_URL=             # exactly as Search Console spells it, e.g. sc-domain:example.com
# GOOGLE_SEARCH_CONSOLE_CREDENTIALS=   # the service-account key JSON, on one line
# GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=  # or these two instead of the JSON above
# GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# SEARCH_CONSOLE_BACKFILL_DAYS=90      # how far back a first sync reaches
# SEARCH_CONSOLE_REFRESH_DAYS=5        # recent days re-read each sync; Google revises them
# SEARCH_CONSOLE_LAG_DAYS=2            # the newest day worth asking for
# SEARCH_CONSOLE_ROW_LIMIT=5000        # rows per request; Google's ceiling is 25000
# SEARCH_CONSOLE_MAX_REQUESTS=60       # ceiling on one sync
# SEARCH_CONSOLE_RETENTION_DAYS=480    # how long measurements are kept

# ---------------------------------------------------------------- Product research
#
# Automatic discovery of candidate source pages for the knowledge base. Optional
# in the strongest sense: with none set, product preparation still finds sources
# in the Brand Source Registry, in the addresses staff attach to a product and
# in the documents they provide, and reports the automatic part as
# NOT_CONFIGURED rather than pretending to have searched (A-6).
#
# A provider only ever returns addresses. Every page it names is still fetched
# through the SSRF-guarded fetcher, checked against robots.txt, matched against
# the product's own identifiers and proposed as a claim a person accepts. No
# search result becomes a product fact.
#
# Set up for brave: create a key at https://api-dashboard.search.brave.com/ and
# paste it below. The free tier is enough for occasional preparation runs.
# PRODUCT_RESEARCH_PROVIDER=none       # none | brave | local  (local: free — see below)
# BRAVE_SEARCH_API_KEY=                # required when PRODUCT_RESEARCH_PROVIDER=brave

# ------------------------------------------------ Intelligent document extraction
#
# Optional, off by default (D-123). A manufacturer page that states its facts in
# sentences ("delivers 100% gray coverage", "leave it on for 25 minutes") gives
# the structured readers little to use. With a provider set, such a page — only
# one Manifest already retrieved, and only when the structured readers found
# little — is also read by Claude, which must quote the page for everything it
# reports. Every value is then checked word for word and number for number
# against the page's own text; the stored evidence is the page's excerpt, never
# the model's wording; and each value is still a claim a person accepts. AI
# readings count towards VERIFIED only after an owner activates the draft policy
# "Official manufacturer documentation, read with AI assistance".
# Uses ANTHROPIC_API_KEY above (shared with SeoPulse's content generator).
# PRODUCT_EXTRACTION_PROVIDER=none     # none | anthropic | ollama  (ollama: local, free — see below)
# PRODUCT_EXTRACTION_MODEL=claude-opus-5

# ------------------------------------------------ Local research and AI (free)
#
# D-124, docs/LOCAL_AI_SETUP.md. Crawling and AI run on this computer; no key,
# no per-product charge, and no cloud fallback. Each piece is optional and
# degrades to what Manifest does without it.
#
#   PRODUCT_RESEARCH_PROVIDER=local     official-domain sitemaps + local SearXNG
#   PRODUCT_EXTRACTION_PROVIDER=ollama  a local model reads prose, grounded against the page
#   SEO_PULSE_AI_PROVIDER=ollama        a local model drafts content from verified facts
#
# Only loopback addresses are used unless the *_ALLOW_REMOTE flag is set.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=                        # a model installed in Ollama; no default
# OLLAMA_EXTRACTION_MODEL=             # optional, overrides OLLAMA_MODEL for reading pages
# OLLAMA_SEO_MODEL=                    # optional, overrides OLLAMA_MODEL for SeoPulse
# OLLAMA_TIMEOUT_MS=240000
# OLLAMA_NUM_CTX=16384
# OLLAMA_ALLOW_REMOTE=false
# SEARXNG_BASE_URL=http://127.0.0.1:8080   # JSON output must be enabled in settings.yml
# SEARXNG_ALLOW_REMOTE=false
# LOCAL_BROWSER_RENDERER=none          # none | playwright (npx playwright install chromium)
